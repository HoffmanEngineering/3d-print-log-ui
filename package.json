{
  "name": "print-log-ui",
  "version": "1.12.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 ",
    "build:dev": "ng build",
    "build": "ng build --prod",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "cypress open",
    "source-map-explorer": "ng build --prod --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "parse-cura": "ts-node --project cura-machine-def-parser/tsconfig.json cura-machine-def-parser/parser.ts",
    "postinstall": "ngcc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~12.0.2",
    "@angular/cdk": "^12.0.2",
    "@angular/common": "~12.0.2",
    "@angular/compiler": "~12.0.2",
    "@angular/core": "~12.0.2",
    "@angular/flex-layout": "^12.0.0-beta.34",
    "@angular/forms": "~12.0.2",
    "@angular/material": "^12.0.2",
    "@angular/material-moment-adapter": "^12.0.2",
    "@angular/platform-browser": "~12.0.2",
    "@angular/platform-browser-dynamic": "~12.0.2",
    "@angular/router": "~12.0.2",
    "@angular/youtube-player": "^12.0.2",
    "@auth0/auth0-spa-js": "^1.13.6",
    "@microsoft/applicationinsights-web": "^2.6.2",
    "@types/lodash": "^4.14.168",
    "d3": "^6.5.0",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.1",
    "ng2-adsense": "^9.1.0",
    "ngx-toastr": "^13.2.1",
    "parse-duration": "^0.4.4",
    "rxjs": "~6.6.3",
    "tslib": "^2.1.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.0.2",
    "@angular/cli": "~12.0.2",
    "@angular/compiler-cli": "~12.0.2",
    "@angular/language-service": "~12.0.2",
    "@cypress/webpack-preprocessor": "^5.4.6",
    "@types/cypress": "^1.1.3",
    "@types/d3": "^6.3.0",
    "@types/jasmine": "^3.6.4",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^14.14.31",
    "codelyzer": "^6.0.0",
    "cypress": "^5.6.0",
    "husky": "^5.1.3",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~6.0.0",
    "karma": "^6.3.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.2",
    "ts-loader": "^8.0.13",
    "ts-node": "^9.1.1",
    "tslint": "~6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  }
}
