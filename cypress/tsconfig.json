{
  "include": [
    "e2e/**/*.ts",
    "support/**/*.ts",
    "support/**/*.d.ts",
    "../node_modules/cypress"
  ],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": ["cypress", "@testing-library/cypress"]
  }
}
