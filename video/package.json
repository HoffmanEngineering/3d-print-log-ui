{
  "name": "print-log-video",
  "private": true,
  "version": "0.1.0",
  "description": "Apple-style announcement videos for 3D Print Log, built with Remotion + three.js",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node scripts/capture-ui.mjs",
    "sfx": "node scripts/synth-sfx.mjs",
    "render:vertical": "remotion render QrSpoolVertical out/qr-spool-vertical.mp4 --codec h264 --crf 16",
    "render:horizontal": "remotion render QrSpoolHorizontal out/qr-spool-horizontal.mp4 --codec h264 --crf 16",
    "still": "remotion still QrSpoolVertical",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "@remotion/three": "^4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
