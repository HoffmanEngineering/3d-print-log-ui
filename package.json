{
  "name": "print-log-ui",
  "version": "1.24.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 ",
    "build:dev": "ng build",
    "build": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "cypress open",
    "source-map-explorer": "ng build --configuration production --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "parse-cura": "ts-node --project cura-machine-def-parser/tsconfig.json cura-machine-def-parser/parser.ts",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/datetime-picker": "^9.0.0",
    "@angular-material-components/moment-adapter": "^9.0.0",
    "@angular/animations": "^16.1.1",
    "@angular/cdk": "^16.1.0",
    "@angular/common": "^16.1.1",
    "@angular/compiler": "^16.1.1",
    "@angular/core": "^16.1.1",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^16.1.1",
    "@angular/material": "^16.1.0",
    "@angular/material-moment-adapter": "^16.1.0",
    "@angular/platform-browser": "^16.1.1",
    "@angular/platform-browser-dynamic": "^16.1.1",
    "@angular/router": "^16.1.1",
    "@angular/youtube-player": "^16.1.0",
    "@auth0/auth0-spa-js": "^2.0.8",
    "@microsoft/applicationinsights-web": "^3.0.2",
    "@ngx-loading-bar/core": "^6.0.2",
    "@ngx-loading-bar/http-client": "^6.0.2",
    "@ngx-loading-bar/router": "^6.0.2",
    "@types/lodash": "^4.14.195",
    "ajv": "^8.12.0",
    "currency.js": "^2.0.4",
    "d3": "^7.8.5",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "ng2-adsense": "^13.0.0",
    "ngx-toastr": "^17.0.2",
    "parse-duration": "^1.0.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.0",
    "@angular-eslint/builder": "16.0.3",
    "@angular-eslint/eslint-plugin": "16.0.3",
    "@angular-eslint/eslint-plugin-template": "16.0.3",
    "@angular-eslint/schematics": "16.0.3",
    "@angular-eslint/template-parser": "16.0.3",
    "@angular/cli": "^16.1.0",
    "@angular/compiler-cli": "^16.1.1",
    "@angular/language-service": "^16.1.1",
    "@cypress/webpack-preprocessor": "^5.17.1",
    "@types/cypress": "^1.1.3",
    "@types/d3": "^7.1.0",
    "@types/jasmine": "^4.3.2",
    "@types/jasminewd2": "^2.0.10",
    "@types/node": "^18.16.18",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "cypress": "^12.14.0",
    "eslint": "^8.39.0",
    "husky": "^7.0.4",
    "jasmine-core": "~5.0.1",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^13.2.2",
    "prettier": "2.8.8",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "5.0.x"
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  }
}
