{
  "include": [
    "e2e/**/*.ts",
    "support/**/*.ts",
    "support/**/*.d.ts",
    "../node_modules/cypress"
  ],
  "compilerOptions": {
    // TypeScript 6 turns strict on by default; these specs were never strict.
    "strict": false,
    // Cypress 13's spec bundler forces downlevelIteration, which TypeScript 6
    // deprecates. Drop this when Cypress no longer sets it.
    "ignoreDeprecations": "6.0",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": ["cypress", "@testing-library/cypress"]
  }
}
