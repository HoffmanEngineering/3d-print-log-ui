{
  "name": "print-log-ui",
  "version": "1.47.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 ",
    "start:auth0": "ng serve --ssl --host 0.0.0.0 --configuration=auth0-dev",
    "start:lan": "ng serve --configuration=lan --host 0.0.0.0",
    "start:e2e": "ng serve --configuration=e2e --host 0.0.0.0",
    "build:dev": "ng build --verbose",
    "build": "ng build --configuration production --verbose && node scripts/generate-shells.mjs",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "test:brief": "bash scripts/test-brief.sh",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "verify:shells": "node scripts/verify-shells.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:brief": "bash scripts/lint-brief.sh",
    "e2e": "cypress open",
    "e2e:ci": "cypress run",
    "source-map-explorer": "ng build --configuration production --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "parse-cura": "ts-node --project cura-machine-def-parser/tsconfig.json cura-machine-def-parser/parser.ts",
    "parse-orca": "ts-node --project orca-machine-def-parser/tsconfig.json orca-machine-def-parser/parser.ts",
    "compare-printers": "ts-node --project orca-machine-def-parser/tsconfig.json orca-machine-def-parser/compare.ts",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/material": "^21.2.10",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/platform-server": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@angular/ssr": "^21.2.10",
    "@angular/youtube-player": "^21.2.10",
    "@auth0/auth0-spa-js": "^2.19.2",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@ngbracket/ngx-layout": "^21.0.0",
    "@ngx-loading-bar/core": "^7.0.1",
    "@ngx-loading-bar/http-client": "^7.0.1",
    "@ngx-loading-bar/router": "^7.0.1",
    "@types/lodash": "^4.17.24",
    "ajv": "^8.20.0",
    "currency.js": "^2.0.4",
    "d3": "^7.9.0",
    "html5-qrcode": "^2.3.8",
    "lodash-es": "^4.18.1",
    "ng2-adsense": "^13.0.0",
    "ngx-toastr": "^19.1.0",
    "parse-duration": "^1.1.2",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/language-service": "^21.2.12",
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@testing-library/cypress": "^10.1.3",
    "@types/cypress": "^1.1.6",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "^5.1.15",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^22.19.18",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axe-core": "^4.13.0",
    "baseline-browser-mapping": "^2.10.29",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.4",
    "husky": "^7.0.4",
    "jasmine-core": "~5.1.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "3.3.3",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  }
}
