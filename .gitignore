# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules

# profiling files
chrome-profiler-events*.json
speed-measure-plugin*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
debug.log

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings


# System Files
.DS_Store
Thumbs.db

/cura-machine-def-parser/out

# OrcaSlicer parser output (regeneratable — run npm run parse-orca / npm run compare-printers)
/orca-machine-def-parser/out/*.json

/test_reports

# Ignores for Cypress
cypress.env.json
cypress/screenshots/
cypress/videos/
cypress/downloads/

# Internal planning and design docs — keep local, not for the public repo.
# Ignore the contents rather than the directory itself, so specific subtrees can
# be re-included below (git cannot re-include a file under an excluded directory).
/docs/*
# Analytics queries are operational, not planning docs — these ship with the repo
# so the monthly telemetry review is reproducible by anyone with portal access.
!/docs/analytics/

# Git worktrees
.worktrees/
# Superpowers brainstorm sessions
.superpowers/

# Claude Code local settings (personal permissions/paths — not for committing)
.claude/settings.local.json

# Production and staging environment files contain sensitive keys — never commit
src/environments/environment.prod.ts
src/environments/environment.staging.ts

# Auth0 dev environment — requires a real Auth0 tenant, copy from example
src/environments/environment.auth0-dev.ts

.sitemap-smoke/

# Cypress artifacts from failed runs
cypress/screenshots/
cypress/videos/

# Generated /docs Angular sources and data artifacts — run `npm run docs:generate`.
# Authored content lives in src/content/docs/*.md.
/src/app/documentation/generated/

# Dev-server logs from `npm start > ng-serve.log`.
/ng-serve.log
/ng-serve.err.log

# Capture-run sidecars: what a capture run was supposed to produce, read by
# scripts/process-captures.mjs. Regenerated by every run.
cypress/captures/
