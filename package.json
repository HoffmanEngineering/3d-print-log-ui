{
  "name": "print-log-ui",
  "version": "1.55.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-docs.mjs --quiet --watch --then ng serve --ssl --host 0.0.0.0",
    "start:auth0": "node scripts/build-docs.mjs && ng serve --ssl --host 0.0.0.0 --configuration=auth0-dev",
    "start:lan": "node scripts/build-docs.mjs && ng serve --configuration=lan --host 0.0.0.0",
    "start:e2e": "node scripts/build-docs.mjs && ng serve --configuration=e2e --host 0.0.0.0",
    "build:dev": "node scripts/build-docs.mjs && ng build --verbose",
    "build": "node scripts/build-docs.mjs && ng build --configuration production --verbose && node scripts/generate-shells.mjs",
    "test": "node scripts/build-docs.mjs && ng test",
    "test:ci": "node scripts/build-docs.mjs && ng test --no-watch",
    "test:coverage": "node scripts/build-docs.mjs && ng test --no-watch --coverage",
    "test:brief": "node scripts/build-docs.mjs && bash scripts/test-brief.sh",
    "test:scripts": "node scripts/build-docs.mjs && node scripts/validate-docs.mjs && node --test scripts/*.test.mjs",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "verify:shells": "node scripts/verify-shells.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:brief": "bash scripts/lint-brief.sh",
    "e2e": "cypress open",
    "e2e:ci": "cypress run",
    "capture:home": "cypress run --browser chrome --config-file cypress.config.capture.ts --spec cypress/e2e/home/capture-home-screenshots.cy.ts",
    "capture:home:process": "node scripts/process-captures.mjs home",
    "capture:home:all": "start-server-and-test start https-get://localhost:4200 \"npm run capture:home && npm run capture:home:process\"",
    "capture:docs": "cypress run --browser chrome --config-file cypress.config.capture.ts --spec cypress/e2e/docs/capture-doc-figures.cy.ts",
    "capture:docs:process": "node scripts/process-captures.mjs docs",
    "capture:docs:all": "start-server-and-test start https-get://localhost:4200 \"npm run capture:docs && npm run capture:docs:process\"",
    "source-map-explorer": "node scripts/build-docs.mjs && ng build --configuration production --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "prepare": "husky install",
    "docs:generate": "node scripts/build-docs.mjs",
    "discovery:generate": "node scripts/generate-discovery.mjs",
    "discovery:sync-skill": "node scripts/sync-agent-skill.mjs",
    "email-assets": "node scripts/generate-email-assets.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@angular/youtube-player": "^22.2.5",
    "@auth0/auth0-spa-js": "^2.19.2",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@ngx-loading-bar/core": "^7.0.1",
    "@ngx-loading-bar/http-client": "^7.0.1",
    "@ngx-loading-bar/router": "^7.0.1",
    "@types/lodash": "^4.17.24",
    "ajv": "^8.20.0",
    "currency.js": "^2.0.4",
    "d3": "^7.9.0",
    "html5-qrcode": "^2.3.8",
    "lodash-es": "^4.18.1",
    "minisearch": "^7.2.0",
    "ng2-adsense": "^13.0.0",
    "ngx-toastr": "^20.0.5",
    "parse-duration": "^2.1.9",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@testing-library/cypress": "^10.1.3",
    "@types/cypress": "^1.1.6",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.19.18",
    "@types/qrcode": "^1.5.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.13.0",
    "baseline-browser-mapping": "^2.10.29",
    "cypress": "^16.2.0",
    "cypress-axe": "^1.7.0",
    "esbuild": "0.27.3",
    "eslint": "^9.39.4",
    "husky": "^7.0.4",
    "lint-staged": "^15.5.2",
    "playwright": "^1.64.1",
    "prettier": "3.3.3",
    "sharp": "^0.35.3",
    "source-map-explorer": "^2.5.3",
    "start-server-and-test": "^3.0.11",
    "tslint-config-prettier": "^1.18.0",
    "turndown": "^7.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  },
  "overrides": {
    "ngx-toastr": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    }
  }
}
