{
  "name": "print-log-ui",
  "version": "1.25.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 ",
    "build:dev": "ng build",
    "build": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "cypress open",
    "source-map-explorer": "ng build --configuration production --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "parse-cura": "ts-node --project cura-machine-def-parser/tsconfig.json cura-machine-def-parser/parser.ts",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/datetime-picker": "^16.0.1",
    "@angular-material-components/moment-adapter": "^16.0.1",
    "@angular/animations": "^17.0.5",
    "@angular/cdk": "^17.0.2",
    "@angular/common": "^17.0.5",
    "@angular/compiler": "^17.0.5",
    "@angular/core": "^17.0.5",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^17.0.5",
    "@angular/material": "^17.0.2",
    "@angular/material-moment-adapter": "^17.0.2",
    "@angular/platform-browser": "^17.0.5",
    "@angular/platform-browser-dynamic": "^17.0.5",
    "@angular/router": "^17.0.5",
    "@angular/youtube-player": "^17.0.2",
    "@auth0/auth0-spa-js": "^2.1.2",
    "@microsoft/applicationinsights-web": "^3.0.5",
    "@ngx-loading-bar/core": "^6.0.2",
    "@ngx-loading-bar/http-client": "^6.0.2",
    "@ngx-loading-bar/router": "^6.0.2",
    "@types/lodash": "^4.14.202",
    "ajv": "^8.12.0",
    "currency.js": "^2.0.4",
    "d3": "^7.8.5",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "ng2-adsense": "^13.0.0",
    "ngx-toastr": "^18.0.0",
    "parse-duration": "^1.0.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "^0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.5",
    "@angular-eslint/builder": "17.1.1",
    "@angular-eslint/eslint-plugin": "17.1.1",
    "@angular-eslint/eslint-plugin-template": "17.1.1",
    "@angular-eslint/schematics": "17.1.1",
    "@angular-eslint/template-parser": "17.1.1",
    "@angular/cli": "^17.0.5",
    "@angular/compiler-cli": "^17.0.5",
    "@angular/language-service": "^17.0.5",
    "@cypress/webpack-preprocessor": "^6.0.0",
    "@types/cypress": "^1.1.3",
    "@types/d3": "^7.1.0",
    "@types/jasmine": "^5.1.4",
    "@types/jasminewd2": "^2.0.10",
    "@types/node": "^18.16.18",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "cypress": "^13.6.0",
    "eslint": "^8.53.0",
    "husky": "^7.0.4",
    "jasmine-core": "~5.1.1",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "3.1.0",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "5.2"
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  }
}
