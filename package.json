{
  "name": "print-log-ui",
  "version": "1.19.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host 0.0.0.0 ",
    "build:dev": "ng build",
    "build": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "cypress open",
    "source-map-explorer": "ng build --configuration production --sourceMap=true && source-map-explorer dist/print-log-ui/*",
    "prettier": "prettier --check src/**/*.*",
    "prettier:fix": "prettier --write src/**/*.*",
    "parse-cura": "ts-node --project cura-machine-def-parser/tsconfig.json cura-machine-def-parser/parser.ts",
    "postinstall": "ngcc",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/datetime-picker": "^7.0.1",
    "@angular-material-components/moment-adapter": "^7.0.0",
    "@angular/animations": "^14.1.0",
    "@angular/cdk": "^14.1.0",
    "@angular/common": "^14.1.0",
    "@angular/compiler": "^14.1.0",
    "@angular/core": "^14.1.0",
    "@angular/flex-layout": "^14.0.0-beta.40",
    "@angular/forms": "^14.1.0",
    "@angular/material": "^14.1.0",
    "@angular/material-moment-adapter": "^14.1.0",
    "@angular/platform-browser": "^14.1.0",
    "@angular/platform-browser-dynamic": "^14.1.0",
    "@angular/router": "^14.1.0",
    "@angular/youtube-player": "^14.1.0",
    "@auth0/auth0-spa-js": "^1.22.2",
    "@microsoft/applicationinsights-web": "^2.8.5",
    "@types/lodash": "^4.14.182",
    "currency.js": "^2.0.4",
    "d3": "^7.2.1",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "ng2-adsense": "^11.0.0",
    "ngx-toastr": "^15.0.0",
    "parse-duration": "^1.0.2",
    "rxjs": "~7.4.0",
    "tslib": "^2.3.1",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.1.0",
    "@angular-eslint/builder": "14.0.2",
    "@angular-eslint/eslint-plugin": "14.0.2",
    "@angular-eslint/eslint-plugin-template": "14.0.2",
    "@angular-eslint/schematics": "14.0.2",
    "@angular-eslint/template-parser": "14.0.2",
    "@angular/cli": "^14.1.0",
    "@angular/compiler-cli": "^14.1.0",
    "@angular/language-service": "^14.1.0",
    "@cypress/webpack-preprocessor": "^5.4.6",
    "@types/cypress": "^1.1.3",
    "@types/d3": "^7.1.0",
    "@types/jasmine": "^4.0.3",
    "@types/jasminewd2": "^2.0.10",
    "@types/node": "^16.11.12",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "cypress": "^10.3.0",
    "eslint": "^8.20.0",
    "husky": "^7.0.4",
    "jasmine-core": "~4.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "^2.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "2.7.1",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.2",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.7.4"
  },
  "lint-staged": {
    "*.{js,css,md,ts,scss}": "prettier --write"
  }
}